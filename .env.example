# Use `ops init --demo` to generate a private random local signing key.
OPS_SIGNING_KEY=
OPS_ENVIRONMENT=local
OPS_DEMO_MODE=false
OPS_DATABASE_URL=sqlite:///ops.db
# OPS_REDIS_URL=redis://127.0.0.1:6379/0
OPS_TOOL_TRANSPORT=local
OPS_LLM_ENABLED=false
# Never put a real provider credential in this example.
# OPS_LLM_API_KEY=
# Production requires an administrator-controlled HTTPS OIDC JWKS endpoint:
# OPS_OIDC_JWKS_URL=
# OPS_AUTH_ISSUER=
# OPS_AUTH_AUDIENCE=
